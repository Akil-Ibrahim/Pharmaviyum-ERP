# ============================================
# PharmaViyum CRM Environment Configuration
# ============================================
# ⚠️  SECURITY WARNING:
# - NEVER commit .env file to version control
# - Use strong, unique values for all secrets
# - Rotate secrets regularly
# - Use different values for each environment
# ============================================

# ============================================
# Application Configuration
# ============================================
PROJECT_NAME=PharmaViyum CRM
PROJECT_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# Security Configuration
# ⚠️  CRITICAL: Generate strong random values
# ============================================
# Generate with: openssl rand -hex 32
API_SECRET_KEY=your_super_secret_key_at_least_32_characters_long_here

# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=your_strong_admin_password_here

ADMIN_EMAIL=admin@pharmaviyum.com

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_AUDIENCE=pharmaviyum-api
JWT_ISSUER=pharmaviyum

# ============================================
# CORS Configuration
# ⚠️  SECURITY: Specify exact origins, never use *
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://pharmaviyum.com

# ============================================
# Database Configuration
# ⚠️  SECURITY: Use strong passwords
# ============================================
DATABASE_URL=postgresql+asyncpg://pharmaviyum:strong_password@localhost:5432/pharmaviyum

# Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================
# AI/Mortarium Configuration
# ============================================
MORTARIUM_AI_URL=http://mortarium-ai:8001
MORTARIUM_AI_TIMEOUT=30
MORTARIUM_AI_ENABLED=true

# ============================================
# Observability Configuration
# ============================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Prometheus metrics
PROMETHEUS_ENABLED=true

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# ============================================
# Backup Configuration
# ============================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# ============================================
# Deployment Configuration
# ============================================
ENVIRONMENT=production
DEPLOY_TOKEN=
