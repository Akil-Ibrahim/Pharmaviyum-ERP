# ============================================================================
# PHARMAVIYUM AI - Environment Configuration
# ============================================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
USE_CLOUD_LLM=false
CLOUD_LLM_PROVIDER=qwencloud

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (local Docker Compose uses Mailpit at mailpit:1025; use localhost when running API outside Docker)
EMAILS_ENABLED=true
APP_URL=http://localhost:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAILS_FROM=noreply@pharmaviyum.local

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharmaviyum
PGVECTOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pharmaviyum

# ============================================================================
# LLM PROVIDERS (choose one)
# ============================================================================

# Option 1: Ollama (local, requires GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_MAIN_MODEL=qwen3.5:9b
OLLAMA_COMPLEX_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Option 2: Gemini (cloud, free tier)
# Get a free API key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024

# Option 3: Groq (cloud)
# Get free API key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Option 4: OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COMPLEX_MODEL=gpt-4o

# Option 5: QwenCloud (OpenAI-compatible cloud API; selected for the demo)
# Keep QWEN_FREE_QUOTA_ONLY=true and also enable "Free quota only" in QwenCloud Console.
# This application-side setting is a fail-closed configuration check; the provider
# console switch is the authoritative protection against paid usage.
QWEN_API_KEY=
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_FAST_MODEL=qwen3.8-flash
QWEN_COMPLEX_MODEL=qwen3.8-flash
QWEN_FREE_QUOTA_ONLY=true
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_OUTPUT_TOKENS=500

# Option 6: Anthropic Claude (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LangSmith (optional)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pharmaviyum-pharmacist-agent

# OpenTelemetry
OTEL_ENABLED=false

# RAG Pipeline
RAG_MAX_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=10
RAG_RERANK_TOP_N=5
RAG_ENABLE_HYDE=true
RAG_ENABLE_MULTI_QUERY=true
RAG_ENABLE_CONTEXTUAL_COMPRESSION=true

# Agent
AGENT_MAX_ITERATIONS=5
AGENT_MAX_HISTORY_MESSAGES=10
AGENT_ENABLE_CHECKPOINTER=true
AGENT_ENABLE_HITL=true
AGENT_SAFETY_SCORE_THRESHOLD=0.9

# Halal Compliance
HALAL_DEFAULT_COUNTRY=SA
HALAL_DEFAULT_FIQH=Hanbali
HALAL_ENABLE_ISTIHALAH_CHECK=true
HALAL_ENABLE_DARURAH_EXCEPTION=true
HALAL_STRICT_MODE=true

# MCP Server
MCP_SERVER_NAME=pharmaviyum-mcp
MCP_SERVER_VERSION=1.0.0
MCP_TOOL_TIMEOUT_SECONDS=30.0
MCP_MAX_RETRIES=3
MCP_ENABLE_RBAC=true
MCP_ENABLE_ANALYTICS=true
