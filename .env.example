# =============================================================================
# Pharmaviyum-CRM Environment Configuration (.env)
# Copy this file to .env and fill in your actual values
# SECURITY: Never commit .env with real values to version control!
# =============================================================================

# === Application Settings ===
APP_NAME=pharmaviyum-crm
APP_VERSION=1.0.0
ENVIRONMENT=production  # options: development, staging, production
DEBUG=false
LOG_LEVEL=INFO

# === PostgreSQL Database ===
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_password_here  # CHANGE THIS!
POSTGRES_DB=pharmaviyum
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_user:${POSTGRES_PASSWORD}@db:5432/pharmaviyum

# === Redis Cache ===
REDIS_PASSWORD=your_redis_password_here  # CHANGE THIS!
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# === FastAPI Backend ===
BACKEND_PORT=8000
WORKERS=2
PYTHONUNBUFFERED=1

# === Security & Authentication ===
SECRET_KEY=your_super_secret_key_min_32_chars  # CHANGE THIS!
JWT_SECRET_KEY=your_jwt_secret_key  # CHANGE THIS!
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# === Mortarium AI (RAG Service) ===
MORTARIUM_PORT=8001
MODEL_PATH=/app/models/qwen2.5-7b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=32000
MODEL_TEMPERATURE=0.15
AI_SERVICE_URL=http://mortarium-ai:8000

# === Nginx Reverse Proxy ===
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_DOMAIN=localhost  # Change to your domain in production

# === Monitoring & Observability ===
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
LOG_FORMAT=json  # options: json, text
SENTRY_DSN=  # Optional: Sentry error tracking

# === Feature Flags ===
ENABLE_RAG=true
ENABLE_ANALYTICS=false
MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# === Backup & Maintenance ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron)
BACKUP_RETENTION_DAYS=7
