# Application
APP_NAME=Pharmaviyum CRM
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharmaviyum

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mortarium AI
MORTARIUM_MODEL_PATH=./models/qwen2.5-7b-instruct-q4_k_m.gguf
MORTARIUM_EMBEDDING_MODEL=BAAI/bge-m3
MORTARIUM_CONTEXT_LENGTH=8192
MORTARIUM_CACHE_TTL=3600

# POS Integrations (fill with real API keys)
KIOVIET_API_URL=
KIOVIET_API_KEY=
SAPO_API_URL=
SAPO_API_KEY=
VIETTEL_PMS_API_URL=
VIETTEL_PMS_API_KEY=
