#!/bin/bash
# ======================================================
# Pharmavium-CRM Setup Script (Best Practices)
# Logs everything and sends errors to Telegram
# ======================================================

set -euo pipefail

# -------------------
# CONFIG
# -------------------
PROJECT_DIR="Pharmavium-CRM"
VENV_DIR=".venv"
PYTHON_VERSION="3.14.2"
LOG_FILE="setup.log"
REQUIREMENTS_DIR="requirements"

# Telegram configuration
TELEGRAM_BOT_TOKEN="8570411206:AAFgHc3V3WoM3KxFYVeSJYJ0Frxq60QuCoc"
TELEGRAM_CHAT_ID="6341367553"

# -------------------
# FUNCTIONS
# -------------------

log() {
    echo -e "[`date '+%Y-%m-%d %H:%M:%S'`] $*" | tee -a "$LOG_FILE"
}

send_telegram() {
    local message="$1"
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
         -d chat_id="${TELEGRAM_CHAT_ID}" \
         -d text="$message" > /dev/null
}

# Redirect stdout/stderr to log and Telegram
exec > >(tee -a "$LOG_FILE") 2> >(tee -a "$LOG_FILE" >(while read -r line; do
    send_telegram "❌ $line"
done))

# Trap unexpected exit
trap 'send_telegram "❌ Script ended unexpectedly at line $LINENO with exit code $?"' EXIT

run_step() {
    local step_name="$1"
    shift
    log "🚀 Starting: $step_name"
    "$@" 
    local status=$?
    if [ $status -ne 0 ]; then
        local msg="❌ Step '$step_name' failed with exit code $status"
        log "$msg"
        send_telegram "$msg"
        exit $status
    fi
    log "✅ Finished: $step_name"
}

# Git branch creation
create_branch() {
    local branch="$1"
    local base="$2"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        log "✅ Branch '$branch' exists"
    else
        run_step "Create branch $branch" git checkout -b "$branch" "$base"
        run_step "Push branch $branch" git push origin "$branch"
    fi
}

# Python dependencies
install_dependencies() {
    log "📦 Installing Python dependencies..."
    run_step "Upgrade pip" pip install --upgrade pip
    for req in "$REQUIREMENTS_DIR"/*.txt; do
        if [[ -f "$req" ]]; then
            run_step "Install $req" pip install -r "$req"
        fi
    done
}

# GitHub Actions workflows
setup_github_actions() {
    log "⚙️ Setting up GitHub Actions workflows..."
    mkdir -p .github/workflows

    cat > .github/workflows/dev.yml <<EOF
name: Dev CI
on:
  push:
    branches: [dev]

jobs:
  backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v4
        with:
          python-version: "$PYTHON_VERSION"
      - run: pip install -r requirements/prod.txt -r requirements/dev.txt
      - run: pytest || true
