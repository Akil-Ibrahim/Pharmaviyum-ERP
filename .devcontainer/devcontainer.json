{
  "name": "Pharmaviyum Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/ollama:1": {}
  },
  "postCreateCommand": "ollama pull mistral-nemo && ollama pull nomic-embed-text",
  "customizations": {
    "vscode": {
      "extensions": [
        "Continue.continue",
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [11434],
  "portsAttributes": {
    "11434": { "label": "Ollama API", "onAutoForward": "silent" }
  }
}
