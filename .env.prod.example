# ============================================================================
# Production Environment Variables
# ============================================================================

# Database
DB_USER=pharmaviyum
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=pharmaviyum
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# Application
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_THIS_VERY_LONG_RANDOM_STRING
LOG_LEVEL=INFO

# API
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=["https://yourdomain.com"]

# Mortarium AI
MORTARIUM_MODEL_PATH=/app/models/qwen2.5-7b-instruct-q4_k_m.gguf
MORTARIUM_EMBEDDING_MODEL=BAAI/bge-m3
MORTARIUM_CONTEXT_LENGTH=8192

# POS Integrations
KIOVIET_API_URL=
KIOVIET_API_KEY=
SAPO_API_URL=
SAPO_API_KEY=
VIETTEL_PMS_API_URL=
VIETTEL_PMS_API_KEY=

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Telemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pharmaviyum-crm
OTEL_EXPORTER_ENDPOINT=
