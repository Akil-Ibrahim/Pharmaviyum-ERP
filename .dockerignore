# ============================================================================
# Docker build context exclusions
# ============================================================================

# Python
__pycache__
*.pyc
*.pyo
*.pyd
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
env/
venv/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git
.gitignore

# Environment files
.env
.env.local
.env.*.local

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Documentation (not needed in image)
docs/
*.md
!README.md

# Tests (not needed in production image)
tests/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp files
tmp/
temp/
*.tmp

# Node (if any frontend)
node_modules/
package-lock.json
yarn.lock
