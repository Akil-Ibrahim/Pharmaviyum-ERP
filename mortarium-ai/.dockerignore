# ==========================================
# SOURCE CONTROL & VERSIONING
# ==========================================
.git
.gitignore
.gitattributes

# ==========================================
# IDE & EDITORS
# ==========================================
.vscode
.idea
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ==========================================
# PYTHON ARTIFACTS
# ==========================================
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# VIRTUAL ENVIRONMENTS
# ==========================================
.env
.venvenv/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# ENVIRONMENT VARIABLES (NEVER INCLUDE!)
# ==========================================
.env*
!.env.example

# ==========================================
# TESTING & COVERAGE
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ==========================================
# DOCUMENTATION
# ==========================================
docs/
*.md
CHANGELOG.md
CONTRIBUTING.md

# ==========================================
# DOCKER FILES (avoid circular references)
# ==========================================
Dockerfile*
docker-compose*.yml
.dockerignore

# ==========================================
# CI/CD CONFIGS
# ==========================================
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
.circleci/

# ==========================================# LOGS & TEMPORARY FILES
# ==========================================
*.log
*.tmp
*.bak
*.cache
*.orig
.DS_Store
Thumbs.db

# ==========================================
# APPLICATION DATA (MOUNTED AS VOLUMES)
# These should NOT be baked into the image
# ==========================================
models/
data/
logs/
vector_store/
