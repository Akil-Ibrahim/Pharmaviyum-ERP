# =============================================================================
# Mortarium AI Environment Configuration (.env)
# RAG Service with Qwen LLM for Pharmacy Domain Knowledge
# Copy this file to .env and configure for your deployment
# SECURITY: Never commit .env with real values to version control!
# =============================================================================

# === Service Settings ===
SERVICE_NAME=mortarium-ai
LOG_LEVEL=INFO
DEBUG=false
PYTHONUNBUFFERED=1

# === Model Configuration ===
# MODEL_PATH can be:
#   - Absolute path: /app/models/qwen2.5-7b-instruct-q4_k_m.gguf
#   - Directory: /app/models/  (loads first .gguf file)
MODEL_PATH=/app/models/qwen2.5-7b-instruct-q4_k_m.gguf

# Qwen model parameters
MODEL_N_CTX=32000           # Context window size
MODEL_N_GPU_LAYERS=-1       # -1 = use all GPU layers, 0 = CPU only
MODEL_TEMPERATURE=0.15      # Lower = more deterministic
MODEL_TOP_P=0.9            # Nucleus sampling threshold

# === Embedding Model ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# === Vector Store (ChromaDB) ===
VECTOR_STORE_PATH=/app/data/vector_store
VECTOR_STORE_COLLECTION=pharmacy_docs
CHUNK_SIZE=512
CHUNK_OVERLAP=60

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://app_user:secure_password@db:5432/mortarium_db
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# === Redis Cache ===
REDIS_URL=redis://:your_redis_password_here@redis:6379/1
REDIS_CACHE_TTL=3600  # Cache expiration in seconds

# === API Security ===
API_SECRET_KEY=your-super-secret-key-change-in-production  # CHANGE THIS!
RATE_LIMIT_PER_MINUTE=30

# === RAG Settings ===
TOP_K_SEARCH=5              # Number of similar documents to retrieve
RELEVANCE_THRESHOLD=0.7     # Minimum relevance score
MAX_CONTEXT_LENGTH=2000     # Max chars for context in prompt

# === CORS & Frontend ===
ALLOWED_ORIGINS=http://localhost:3000  # Add your frontend URL

# === OpenTelemetry (Observability) ===
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mortarium-ai
ENABLE_TRACING=false  # Enable in production with backend support

# === Timeouts ===
QUERY_TIMEOUT=30            # Query processing timeout (seconds)
MODEL_LOAD_TIMEOUT=300      # Model loading timeout (seconds)

# === Feature Flags ===
ENABLE_RAG=true
ENABLE_CACHE=true
ENABLE_METRICS=true
ENABLE_STREAMING=false  # Enable streaming responses (experimental)
