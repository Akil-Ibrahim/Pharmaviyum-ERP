{
  "name": "pharmaviyum-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run vite",
    "build": "bun run tsc && bun run vite build",
    "preview": "bun run vite preview",
    "test": "bun run vitest",
    "test:e2e": "bunx playwright test",
    "lint": "bun run eslint src --ext ts,tsx",
    "generate-client": "openapi --input http://localhost:8000/openapi.json --output src/client --client axios"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-router": "^1.170.36",
    "axios": "^1.13.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "lucide-react": "^1.46.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@playwright/test": "^1.63.0",
    "vitest": "^5.0.1"
  }
}
