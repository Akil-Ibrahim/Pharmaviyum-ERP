# ============================================================================
# Dockerfile for Background Worker
# Best practice 2026: Separate worker container for scalability
# ============================================================================
# Use same base as main app
FROM python:3.13-slim as builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.13-slim as production
LABEL maintainer="Pharmaviyum Team <dev@pharmaviyum.com>" \
      version="1.0.0" \
      description="Background worker for Pharmaviyum CRM"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ENVIRONMENT=production
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app
WORKDIR /app
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --chown=app:app src/ ./src/
# Copy worker entrypoint
COPY --chown=app:app docker/worker-entrypoint.sh /worker-entrypoint.sh
RUN chmod +x /worker-entrypoint.sh
USER app

# Health check for worker
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import redis; r = redis.from_url('redis://redis:6379'); r.ping()" || exit 1

ENTRYPOINT ["/worker-entrypoint.sh"]
