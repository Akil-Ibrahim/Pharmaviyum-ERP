                                                    # Node
                                                    node_modules/
                                                    dist/
                                                    .vite/

                                                    # Python
                                                    __pycache__/
                                                    *.pyc
                                                    .env
                                                    .venv/

                                                    # IDE
                                                    .vscode/
                                                    .idea/

                                                    # Logs
                                                    *.log
                                                    EOF

                                                    # -------------------
                                                    # requirements.txt
                                                    # -------------------
                                                    echo "📦 Creating requirements.txt..."

                                                    cat > requirements.txt <<EOF
                                                    fastapi==0.128.0
                                                    pydantic==2.8.0
                                                    uvicorn==0.22.0
                                                    SQLAlchemy==2.4.0
                                                    alembic==1.20.0
                                                    psycopg2-binary==2.9.9
                                                    redis==7.6.8
                                                    celery==5.8.2
                                                    sentry-sdk==1.22.0
                                                    opentelemetry-api==1.22.0
                                                    opentelemetry-sdk==1.22.0
                                                    python-dotenv==1.0.0

                                                    # dev
                                                    flake8==7.0.0
                                                    black==24.10.0
                                                    isort==6.0.0
                                                    mypy==1.5.1

                                                    # test
                                                    pytest==8.3.0
                                                    pytest-asyncio==0.22.0
                                                    pytest-cov==4.1.0
                                                    EOF

                                                    # -------------------
                                                    # GitHub Actions
                                                    # -------------------
                                                    echo "⚙️ Creating GitHub Actions..."

                                                    mkdir -p .github/workflows

                                                    cat > .github/workflows/dev.yml <<EOF
                                                    name: Dev CI

                                                    on:
                                                      push:
                                                          branches: [dev]

                                                          jobs:
                                                            backend:
                                                                runs-on: ubuntu-latest
                                                                    steps:
                                                                          - uses: actions/checkout@v3
                                                                                - uses: actions/setup-python@v4
                                                                                        with:
                                                                                                  python-version: "3.12"
                                                                                                        - run: pip install -r requirements.txt
                                                                                                              - run: pytest
                                                                                                              EOF

                                                                                                              # -------------------
                                                                                                              # COMMIT
                                                                                                              # -------------------
                                                                                                              git add .
                                                                                                              git commit -m "chore: initial project setup (branches, deps, CI)" || true
                                                                                                              git push origin dev

                                                                                                              echo "✅ Setup complete"
                                                                                                              echo "Flow: dev → prod → demo"
                                                                                                              echo "Next:"
                                                                                                              echo "  python -m venv .venv"
                                                                                                              echo "  source .venv/bin/activate"
                                                                                                              echo "  pip install -r requirements.txt"
